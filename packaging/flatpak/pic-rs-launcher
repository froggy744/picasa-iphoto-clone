#!/bin/sh
set -eu

# Committed copy of the launcher generated by write_runtime_launcher() in the
# build scripts. PIC predates its Flatpak package and must keep using the
# existing native library and thumbnail cache locations on the host.
if [ -n "${FLATPAK_ID:-}" ]; then
    export XDG_DATA_HOME="${PIC_XDG_DATA_HOME:-$HOME/.local/share}"
    export XDG_CACHE_HOME="${PIC_XDG_CACHE_HOME:-$HOME/.cache}"
fi

# Works both in the AppImage (APPDIR set, AppRun symlink) and in Flatpak
# (launched as /app/bin/pic-rs, no APPDIR).
if [ -n "${APPDIR:-}" ] && [ -d "$APPDIR/usr/share/pic-rs" ]; then
    PREFIX="$APPDIR/usr"
else
    BIN_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
    PREFIX="$(dirname -- "$BIN_DIR")"
fi

cd "$PREFIX/share/pic-rs"
exec "$PREFIX/libexec/pic-rs" "$@"
