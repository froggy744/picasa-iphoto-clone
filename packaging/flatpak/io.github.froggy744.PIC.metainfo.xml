  </recommends>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="1.0.0" date="2026-09-24">
      <description>
        <p>First stable release.</p>
        <ul>
          <li>Bookshelf album library with themes and album covers</li>
          <li>High-performance scrolling for large local collections</li>
          <li>Edit mode with crop, zoom and text tools</li>
          <li>Direct SMB and NFS network browsing with offline mode</li>
          <li>Linux distribution as AppImage and Flatpak</li>
