<!-- PIC AppStream metainfo (Flathub-ready shape).
     App-id must match the .desktop file id and the Flatpak app-id
     (io.github.froggy744.PIC today; rename all three together if the
     app-id changes, e.g. before Flathub submission).
     Screenshots below use local file:// URLs as placeholders: before a
     Flathub submission they must be replaced with publicly hosted
     images (e.g. raw.githubusercontent.com URLs from this repository,
     or a CDN). The source files live in samples/. -->
<component type="desktop-application">
  <id>io.github.froggy744.PIC</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>PIC — Personal Image Catalogue</name>
  <summary>Fast local photo manager inspired by Picasa and iPhoto</summary>
  <developer_name>froggy744</developer_name>
  <description>
    <p>
      PIC is a fast, native photo manager for the Linux desktop. It brings
      the classic Picasa and iPhoto workflow back: a bookshelf of albums,
      instant thumbnail scrolling, and quick fixes, without a cloud account.
    </p>
    <ul>
      <li>Bookshelf-style album library with switchable themes (Aqua, Brushed Metal, Retro)</li>
      <li>Smooth, responsive scrolling through very large local photo collections</li>
      <li>Quick editing tools: crop, zoom, text and basic adjustments</li>
      <li>Reads JPEG, PNG, WebP, GIF, TIFF, BMP, AVIF and HEIF images plus common camera RAW formats</li>
      <li>Browse photos directly on network shares (SMB and NFS) with an offline-tolerant cache</li>
      <li>Fast search across file names and albums</li>
    </ul>
    <p>
      PIC stores its library and thumbnails locally under your XDG data and
      cache directories and can watch any folder you point it at.
    </p>
  </description>
  <launchable type="desktop-id">io.github.froggy744.PIC.desktop</launchable>
  <url type="homepage">https://github.com/froggy744/picasa-iphoto-clone</url>
  <url type="bugtracker">https://github.com/froggy744/picasa-iphoto-clone/issues</url>
  <update_contact>petie74@gmail.com</update_contact>
