+/// Open an already-initialized library for background gallery reads.
+/// Unlike `open_default`, this never runs schema migrations or write PRAGMAs
+/// while an import is holding a write transaction.
+pub fn open_default_read_only() -> Result<Connection> {
+    let path = database_path()?;
+    let connection = Connection::open_with_flags(
+        &path,
+        rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY,
+    )
+    .with_context(|| format!("could not open read-only database {}", path.display()))?;
+    connection.busy_timeout(std::time::Duration::from_secs(3))?;
+    Ok(connection)
 }
 
